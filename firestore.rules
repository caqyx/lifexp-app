rules_version = '2';

// LifeXP — produkcyjne reguły Firestore
// Wgranie: Firebase Console → Firestore Database → zakładka "Rules" → wklej → Publish.
// Model: właściciel ma pełny dostęp do swoich danych; rodzic (po emailu) ma read-only.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Rodzic = zalogowany użytkownik, którego email == parentEmail dziecka.
    // Dla zapytań listujących (parent.html) reguła sprawdza każdy zwracany dokument,
    // więc zapytanie MUSI mieć where('parentEmail','==', <email rodzica>).
    function isParentOfDoc() {
      return isSignedIn() && resource.data.parentEmail == request.auth.token.email;
    }

    // Dla podkolekcji: dociągamy dokument rodzica (users/{uid}) i porównujemy email.
    function isParentOf(uid) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(uid)).data.parentEmail == request.auth.token.email;
    }

    // Admin systemu zgłoszeń błędów — jedyne konto, które widzi WSZYSTKIE bugReports
    // (właściciel danego zgłoszenia i tak widzi swoje własne, patrz reguła niżej).
    function isBugAdmin() {
      return isSignedIn() && request.auth.token.email == 'szymonrogalski098@gmail.com';
    }

match /users/{uid} {
  allow read:   if isOwner(uid) || isParentOfDoc();
  // Przy tworzeniu konta owner nie może od razu wpisać sobie pola aiSettings
  // (np. advancedEnabled: true) — to pole pojawia się dopiero przez Cloud Function.
  allow create: if isOwner(uid) && !('aiSettings' in request.resource.data);
  // Zwykła edycja profilu (goals, xp, itd.) — owner może wszystko OPRÓCZ
  // ruszania aiSettings. To pole zmienia wyłącznie Cloud Function (Admin SDK),
  // który i tak pomija te reguły całkowicie.
  allow update: if isOwner(uid)
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiSettings']);
  allow delete: if isOwner(uid);

      // Wszystkie podkolekcje (activities, dailyLog, gamingSessions, purchases,
      // chores, chorePayouts, choreDefs, activityDefs, money, moneyLoans, ...).
      // Rodzic (read-only) widzi wszystko OPRÓCZ prywatnych danych money trackera:
      // transakcje, kategorie, pożyczki i ustawienia limitu są tylko dla właściciela.
      // Z modułu Money rodzic czyta wyłącznie saldo (money/balance). Cele oszczędnościowe
      // to teraz cele z dashboardu (pole users/{uid}.goals, czytane wyżej z całym users/{uid}).
      // Uwaga: to celowo NIE jest wildcard {document=**} — wildcard dawałby unię
      // uprawnień i nie dałoby się z niego wyciąć wyjątków dla money.
      match /{col}/{docId} {
        allow write: if isOwner(uid);
        allow read:  if isOwner(uid) || (
          isParentOf(uid)
          && col != 'moneyTransactions'
          && col != 'moneyCategories'
          && col != 'moneyLoans'
          && col != 'fcmTokens'
          && !(col == 'money' && docId == 'settings')
        );
      }
    }

    // Zgłoszenia błędów — TOP-LEVEL (nie pod users/{uid}), bo panel admina musi
    // widzieć zgłoszenia wszystkich kont jedną kolekcją. Zgłaszający widzi tylko
    // swoje własne; tylko admin widzi wszystkie i może zmieniać status/kasować.
    match /bugReports/{id} {
      // bonusGranted/bonusUsed nie mogą być ustawiane przy tworzeniu (tylko admin
      // przyznaje bonus przy akceptacji, patrz update niżej) — inaczej zgłaszający
      // mógłby sam sobie przyznać dodatkowe zgłoszenie już na starcie.
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status in ['new', 'spam']
        && !('bonusGranted' in request.resource.data)
        && !('bonusUsed' in request.resource.data);
      allow read:   if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isBugAdmin());
      allow delete: if isBugAdmin();
      // Admin może zmieniać wszystko (status, bonusGranted itd.). Zgłaszający może
      // zmienić TYLKO `messages` (odpowiedź w wątku) i `bonusUsed` — a `bonusUsed`
      // wyłącznie na true (zużycie bonusu), nigdy z powrotem na false (nie da się
      // "odnowić" bonusu samemu).
      allow update: if isBugAdmin() || (
        isSignedIn()
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'bonusUsed'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bonusUsed']) || request.resource.data.bonusUsed == true)
      );
    }

    // Lista słów wymaganych w opisie zgłoszenia (filtr spamu) — każdy zalogowany
    // może odczytać (potrzebne w przeglądarce zgłaszającego, żeby sklasyfikować
    // zgłoszenie przy wysyłce), edytować może tylko admin.
    match /bugReportsConfig/{id} {
      allow read:  if isSignedIn();
      allow write: if isBugAdmin();
    }

// Globalne wiadomości (ogłoszenia admina → baner u wszystkich). Każdy zalogowany
    // czyta, pisze/kasuje tylko admin.
    match /broadcasts/{id} {
      allow read:   if isSignedIn();
      allow create, update, delete: if isBugAdmin();
    }

    // Allowlist kont testowych AI Assistant. Klient może sprawdzić tylko,
    // czy JEGO WŁASNY uid tam jest (żeby pokazać/ukryć przycisk AI w UI).
    // Dodawanie/usuwanie wpisów robi wyłącznie Cloud Function (Admin SDK).
    match /aiTestAccess/{uid} {
      allow read:  if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Globalny dzienny licznik zużycia AI — czysto wewnętrzny,
    // klient nigdy go nie czyta ani nie zapisuje bezpośrednio.
    match /aiUsageGlobal/{date} {
      allow read, write: if false;
    }

    // Liczniki tokenów Ex-us v2 (exusTurn, docs/v2/PLAN.md 6.12): per konto i dzień
    // (aiUsage/{uid}_{YYYY-MM-DD}) oraz globalny bezpiecznik (aiUsageGlobalV2/{YYYY-MM-DD}).
    // Pisze i czyta wyłącznie funkcja (Admin SDK). Klient nie dostaje nawet odczytu
    // własnego licznika: stan paska limitu przychodzi w odpowiedzi exusTurn (`usage`).
    // Top-level celowo: pod users/{uid} reguła wildcard dałaby właścicielowi zapis
    // i mógłby wyzerować sobie licznik.
    match /aiUsage/{id} {
      allow read, write: if false;
    }
    match /aiUsageGlobalV2/{date} {
      allow read, write: if false;
    }

    // Kody weryfikacji e-maila rodzica v2 (sendParentEmailCode / verifyParentEmailCode,
    // docs/v2/PLAN.md 9.1, 6-4): tylko skrót kodu z solą, termin, próby i limity wysyłek.
    // Pisze i czyta wyłącznie funkcja (Admin SDK). Uwaga: v1 do cutover nadal zapisuje
    // parentEmail i kod w users/{uid} po stronie klienta (B12) — ta dziura zostaje dla v1
    // do etapu 7/8; tu niczego jej nie zamykamy.
    match /parentEmailCodes/{uid} {
      allow read, write: if false;
    }
    // Ręczne wysyłki raportu tygodniowego (sendMyReportNow, 6-5): czasy wysyłek do limitu dziennego.
    // Tylko funkcja (Admin SDK).
    match /weeklyReportRuns/{uid} {
      allow read, write: if false;
    }
    // Przypomnienia push (pushReminders / sendMyPushNow, 6-7): co i o której poszło danego dnia
    // (pushLog/{uid}_{dzień w Warszawie}). Tylko funkcja (Admin SDK).
    match /pushLog/{id} {
      allow read, write: if false;
    }
    // Powiadomienia dla rodzica (parentAlertOnGaming / parentAlertOnPurchase, 6-3b): które rodzaje
    // poszły danego dnia (parentAlertLog/{uid}_{dzień}). Tylko funkcja (Admin SDK).
    match /parentAlertLog/{id} {
      allow read, write: if false;
    }
    // Fałszywe FCM — istnieje tylko w emulatorze Functions (push/messaging.ts).
    match /emulatorPush/{uid} {
      allow read, write: if false;
    }
    // Skrzynka fałszywej poczty — istnieje tylko w emulatorze Functions (parent/mailer.ts).
    match /emulatorMail/{uid} {
      allow read, write: if false;
    }
  }
}
