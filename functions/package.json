{
  "name": "lifexp-functions",
  "private": true,
  "description": "LifeXP v2 Cloud Functions (codebase lifexp-v2). Old v1 functions are NOT here — see docs/v2/PLAN.md 6.12.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node -e \"require('fs').rmSync('lib-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"lib-test/**/*.test.js\"",
    "deploy": "npm run build && firebase deploy --only functions:lifexp-v2 --project faiobaj4"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
